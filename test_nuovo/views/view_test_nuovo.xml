<?xml version="1.0" encoding="utf-8"?>
<odoo>
   
      <record id="view_test_nuovo_tree" model="ir.ui.view">
        <field name="name">test.nuovo.tree</field>
        <field name="model">test.nuovo</field>
        <field name="arch"  type="xml">
            <tree>
                <field name="name" />    
            </tree>
        </field>
    </record>

    <record id="view_test_nuovo_form" model="ir.ui.view">
        <field name="name">test.nuovo.form</field>
        <field name="model">test.nuovo</field>
        <field name="arch"  type="xml">
            <form>
                <sheet>
                    <group>
                       <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_test_nuovo" model="ir.actions.act_window">
        <field name="name">test Nuovo</field>
        <field name="res_model">test.nuovo</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_test_nuovo_root"
        name="Test App" />
    
    <menuitem
        id="menu_test_nuovo_action"
        parent="menu_test_nuovo_root"
        action="action_test_nuovo"
        />
        
</odoo>